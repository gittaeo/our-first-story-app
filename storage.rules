rules_version = '2'; service firebase.storage { match /b/{bucket}/o { match /workspaces/{w}/{all=**}{allow read,write:if request.auth!=null&&firestore.exists(/databases/(default)/documents/workspaces/$(w)/members/$(request.auth.uid))&&request.resource.size<10*1024*1024&&request.resource.contentType.matches('image/.*');}}}
