rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { function signedIn(){return request.auth!=null;} function member(w){return signedIn()&&exists(/databases/$(database)/documents/workspaces/$(w)/members/$(request.auth.uid));} function owner(w){return member(w)&&get(/databases/$(database)/documents/workspaces/$(w)/members/$(request.auth.uid)).data.role=='owner';} match /workspaces/{w}{allow read:update: if member(w);allow create:if signedIn()&&request.resource.data.ownerUid==request.auth.uid;allow delete:if owner(w);match /members/{uid}{allow read:if member(w);allow write:if owner(w)||(signedIn()&&uid==request.auth.uid);}match /{all=**}{allow read,write:if member(w);}}match /invites/{tokenHash}{allow read,write:if false;}}}
